{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fursay",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-28",
  "keep_vars": true,
  "vars": {
    "MAILERLITE_GROUP_FURSAY_ALL": "185908848607888784",
    "MAILERLITE_GROUP_KOKO": "185908812467668238",
    "MAILERLITE_GROUP_NOOR": "185908830918411331"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./fursay-optimized-site",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "analytics_engine_datasets": [
    {
      "binding": "FURSAY_EVENTS",
      "dataset": "fursay_events"
    }
  ]
}
